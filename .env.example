# HeliosGen is a local-only desktop app. The packaged build sets everything it
# needs at runtime — you only need this file for `pnpm dev` in a browser, and
# even then every value is optional (API keys are normally saved in-app via
# Settings → API Keys and stored in the local SQLite DB).

# Optional fallback kie.ai key (Settings → API Keys is the normal path).
KIE_API_KEY=

# Optional Azure OpenAI key, only if routing GPT Image 2 through Azure AI Foundry.
AZURE_API_KEY=

# Verbose client logging.
NEXT_PUBLIC_DEBUG=

# Required only for the authenticated browser trial (scripts/web-server.mjs).
# Set real values in your local shell or hosting provider's secret settings.
# Never commit real credentials or API keys.
HELIOS_WEB_USER=owner
HELIOS_WEB_PASSWORD=replace-with-a-long-unique-password

# Optional writable locations for persistent app data and generated media.
HELIOS_DATA_DIR=./data
HELIOS_MEDIA_DIR=./public/generated
