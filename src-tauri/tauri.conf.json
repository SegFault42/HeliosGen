{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ANVIL",
  "version": "1.2.0",
  "identifier": "cash.sdd.helios.desktop",
  "build": {
    "beforeDevCommand": "node scripts/desktop/build-server.mjs --dev",
    "beforeBuildCommand": "node scripts/desktop/build-server.mjs",
    "frontendDist": "./loading"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "ANVIL",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "url": "index.html",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/helios-node"
    ],
    "resources": [
      "server/**/*"
    ],
    "category": "GraphicsAndDesign",
    "shortDescription": "Build AI image & video pipelines visually.",
    "longDescription": "ANVIL is a local-first visual workflow builder for AI image and video generation. All data stays on your machine.",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "entitlements.plist",
      "signingIdentity": null,
      "hardenedRuntime": true
    }
  },
  "plugins": {}
}